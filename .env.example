# ==============================================================================
# PDF-to-Excel Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.
# CLI arguments always take precedence over these environment variables.

# ------------------------------------------------------------------------------
# 1. Binary Dependencies & OCR Paths
# ------------------------------------------------------------------------------
# Path to the Tesseract OCR executable (leave blank if 'tesseract' is on PATH)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/macOS: usually auto-discovered from PATH (/usr/bin/tesseract)
TESSERACT_CMD=

# Directory containing Tesseract language data (.traineddata files)
# Windows example: C:\Program Files\Tesseract-OCR\tessdata
# Linux example: /usr/share/tesseract-ocr/5/tessdata
TESSDATA_PREFIX=

# Directory containing Poppler utilities (pdftoppm, etc.) for pdf2image
# Leave blank if Poppler utilities are installed on system PATH
# Windows example: C:\Program Files\poppler\Library\bin
POPPLER_PATH=

# ------------------------------------------------------------------------------
# 2. OCR Defaults & Tuning
# ------------------------------------------------------------------------------
# OCR Language code (e.g., 'nep' for Nepali, 'eng' for English, 'nep+eng' for bilingual)
OCR_LANG=nep

# Page Segmentation Mode (PSM) for Tesseract (6 = Assume a single uniform block of text)
OCR_PSM=6

# DPI resolution for rasterising PDF pages before OCR (300 recommended, 400 for low-res scans)
OCR_DPI=300

# Minimum confidence threshold (0-100) for OCR word recognition
OCR_CONFIDENCE=70

# ------------------------------------------------------------------------------
# 3. Table Reconstruction Parameters
# ------------------------------------------------------------------------------
# Default extraction strategy: 'auto', 'prompt', 'pdfplumber', or 'ocr'
EXTRACTION_MODE=auto

# Maximum allowed columns before a detected table is considered noise/discarded
MAX_COLUMNS=12

# Clustering tolerance in points for detecting aligned edges/coordinates
EDGE_CLUSTER_TOLERANCE=2.5

# Minimum vertical edge height in points to consider as a table column line
EDGE_MIN_VERTICAL=18.0

# Minimum horizontal edge width in points to consider as a table row line
EDGE_MIN_HORIZONTAL=30.0

# Minimum non-empty cells required for an edge-derived column to be kept
EDGE_COLUMN_MIN_FILL=1

# Tolerance in points for grouping text words into the same table row
Y_TOLERANCE=4.0

# Minimum horizontal gap in points to automatically infer column breaks
MIN_GAP=18.0

# ------------------------------------------------------------------------------
# 4. Output & Logging
# ------------------------------------------------------------------------------
# Default output Excel workbook filename
DEFAULT_OUTPUT=extracted_table.xlsx

# Logging verbosity ('INFO' or 'DEBUG')
LOG_LEVEL=INFO
